# Copy to .env and fill in. Then: chmod 600 .env
# All of these services have free tiers / are free. Never commit .env.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot from @BotFather, and your own chat id (send /start to the bot, then run `dva telegram-whoami`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram Graph API (Business/Creator account). Long-lived token, auto-refreshed by `dva` when possible.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# YouTube uses OAuth: put the downloaded client secret JSON at secrets/youtube_client_secret.json
# and run `dva auth-youtube` once. No env var needed.

# Cloud mode only (optional): Google Drive folder id for videos bigger than 20 MB
DVA_DRIVE_FOLDER_ID=
