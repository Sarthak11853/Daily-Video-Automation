{
  "name": "Daily AI Facts Video (9 AM IST)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 9 * * *" } ] }
      },
      "id": "a1f1c0de-0001-4000-8000-000000000001",
      "name": "Every day 09:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "command": "cd \"$HOME/Daily-Video-Automation\" && .venv/bin/python -m dva run --json 2>> data/logs/n8n-run.stderr.log | tail -n 1"
      },
      "id": "a1f1c0de-0001-4000-8000-000000000002",
      "name": "Run pipeline (discover → research → script → 3D render → QC → Telegram)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [260, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const raw = (item.json.stdout || '').trim();\n  let res;\n  try { res = JSON.parse(raw.split('\\n').pop()); }\n  catch (e) { res = { status: 'crashed', error: (item.json.stderr || item.json.error?.message || raw || 'no output').slice(-1500) }; }\n  out.push({ json: res });\n}\nreturn out;"
      },
      "id": "a1f1c0de-0001-4000-8000-000000000003",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.status }}", "rightValue": "crashed", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f1c0de-0001-4000-8000-000000000004",
      "name": "Pipeline crashed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "command": "=cd \"$HOME/Daily-Video-Automation\" && .venv/bin/python -m dva notify \"🚨 n8n: the daily video pipeline crashed before it could report. Check data/logs/dva.log. Error tail: {{ String($json.error || '').replace(/[\"`$\\\\]/g, '').slice(-600) }}\""
      },
      "id": "a1f1c0de-0001-4000-8000-000000000005",
      "name": "Alert me on Telegram",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1040, -100]
    },
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "17 */6 * * *" } ] }
      },
      "id": "a1f1c0de-0001-4000-8000-000000000006",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 260]
    },
    {
      "parameters": {
        "command": "cd \"$HOME/Daily-Video-Automation\" && .venv/bin/python -m dva metrics"
      },
      "id": "a1f1c0de-0001-4000-8000-000000000007",
      "name": "Collect views / likes / shares",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [260, 260],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "40 3 * * 0" } ] }
      },
      "id": "a1f1c0de-0001-4000-8000-000000000008",
      "name": "Weekly (Sun 03:40)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 460]
    },
    {
      "parameters": {
        "command": "cd \"$HOME/Daily-Video-Automation\" && .venv/bin/python -m dva cleanup --days 14"
      },
      "id": "a1f1c0de-0001-4000-8000-000000000009",
      "name": "Clean old render files",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [260, 460],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every day 09:00 IST": { "main": [ [ { "node": "Run pipeline (discover → research → script → 3D render → QC → Telegram)", "type": "main", "index": 0 } ] ] },
    "Run pipeline (discover → research → script → 3D render → QC → Telegram)": { "main": [ [ { "node": "Parse result", "type": "main", "index": 0 } ] ] },
    "Parse result": { "main": [ [ { "node": "Pipeline crashed?", "type": "main", "index": 0 } ] ] },
    "Pipeline crashed?": { "main": [ [ { "node": "Alert me on Telegram", "type": "main", "index": 0 } ], [] ] },
    "Every 6 hours": { "main": [ [ { "node": "Collect views / likes / shares", "type": "main", "index": 0 } ] ] },
    "Weekly (Sun 03:40)": { "main": [ [ { "node": "Clean old render files", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Kolkata", "saveManualExecutions": true },
  "active": false,
  "pinData": {}
}
